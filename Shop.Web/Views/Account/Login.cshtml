@using Shop.Web.Models.Account
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    ViewData["ShowNavbar"] = false;
}

<h1>Login</h1>

<form asp-controller="Account" asp-action="Login">

    <div asp-validation-summary="ModelOnly"></div>

    <div class="form-floating mb-3">
        <input asp-for="UserNameOrEmail" type="text" class="form-control" placeholder="john@455 or name@example.com" required>
        <label asp-for="UserNameOrEmail" class="form-label">Email/UserName:</label>
        <span asp-validation-for="UserNameOrEmail"></span>
    </div>

 
    <div class="form-floating mb-3">
        <input asp-for="Password" type="password" class="form-control" placeholder="password" required>
        <label asp-for="Password" class="form-label">Password:</label>
        <span asp-validation-for="Password"></span>
    </div>

    
    <div class="d-flex justify-content-between align-items-center">

        <div class="mb-3 form-check">
            <input asp-for="RememberMe" type="checkbox" class="form-check-input">
            <label asp-for="RememberMe" class="form-check-label">RememberMe</label>
            <span asp-validation-for="RememberMe"></span>
        </div>

        <div class="mb-3">
            <label for="createAccount">No Account?</label>
            <a href="/Account/Register" id="createAccount">Create one</a>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center">

        <div class="mb-3">
            <button class="btn btn-primary" type="submit">Login</button>
            <a href="/" class="btn btn-secondary" type="button">Back</a>
        </div>

        <div class="mb-3">
            <a href="#" id="forgot">Forgot Password?</a>
        </div>
    </div>

</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
