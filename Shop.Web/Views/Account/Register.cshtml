@using Shop.Web.Models.Account
@model RegisterUserViewModel

@{
    ViewData["Title"] = "Register";
    ViewData["ShowNavbar"] = false;
}

<h1>Register</h1>

<form asp-controller="Account" asp-action="Register" method="post">

    <div asp-validation-summary="ModelOnly"></div>

    <div class="form-floating mb-3">
        <input asp-for="UserName" type="text" class="form-control" placeholder="john@455" required>
        <label asp-for="UserName" class="form-label">UserName:</label>
        <span asp-validation-for="UserName"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required>
        <label asp-for="Email" class="form-label">Email address:</label>
        <div class="form-text">We'll never share your email with anyone else.</div>
        <span asp-validation-for="Email"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Password" type="password" class="form-control" placeholder="password" required>
        <label asp-for="Password" class="form-label">Password:</label>
        <span asp-validation-for="Password"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="ConfirmedPassword" type="password" class="form-control" placeholder="confirm password" required>
        <label asp-for="ConfirmedPassword" class="form-label">ConfirmedPassword:</label>
        <span asp-validation-for="ConfirmedPassword"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="AcceptedTermsAndConditions" type="checkbox" class="form-check-input">
        <label asp-for="AcceptedTermsAndConditions" class="form-check-label"> Agree to terms and conditions </label>
        <div class="mb-3">
            <span asp-validation-for="AcceptedTermsAndConditions"></span>
        </div>
       
    </div>

    <div class="col-12">
        <button class="btn btn-primary" type="submit">Register</button>
        <a href="/Account/Login" class="btn btn-secondary" type="button">Back</a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
